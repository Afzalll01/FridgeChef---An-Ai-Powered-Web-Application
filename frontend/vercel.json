{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/profile",
      "dest": "/profile.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
